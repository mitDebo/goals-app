# Copy to /opt/apps/goals-app/.env on the droplet and fill in real values.
# Never commit the real .env.

# Supabase session-pooler connection string for the goals_app login (task 4.x).
GOALS_DB_CONNECTION=Host=example.pooler.supabase.com;Port=5432;Database=postgres;Username=goals_app.example;Password=change-me;SSL Mode=Require

# Optional: pin image versions (defaults to "latest"). Useful for rollbacks.
# BACKEND_TAG=latest
# FRONTEND_TAG=latest
